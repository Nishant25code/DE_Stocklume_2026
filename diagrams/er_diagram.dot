// Rendered with: dot -Tpng -Gdpi=150 diagrams/er_diagram.dot -o diagrams/er_diagram.png
digraph gpay {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.1, fontname="Helvetica", label="Google Pay (UPI) — schema gpay   (PK = primary key, FK = foreign key, UK = unique)", labelloc=t, fontsize=18];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#555555", arrowhead=crow, arrowtail=tee, dir=both];

  cities [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1a73e8" colspan="3"><font color="white"><b>cities</b></font></td></tr>
    <tr><td>PK</td><td align="left">city_id</td><td align="left">smallint</td></tr>
    <tr><td>UK</td><td align="left">city_name</td><td align="left">varchar(50)</td></tr>
    <tr><td></td><td align="left">state</td><td align="left">varchar(50)</td></tr></table>>];

  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1a73e8" colspan="3"><font color="white"><b>users</b></font></td></tr>
    <tr><td>PK</td><td align="left">user_id</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">full_name</td><td align="left">varchar(100)</td></tr>
    <tr><td>UK</td><td align="left">phone</td><td align="left">varchar(10)</td></tr>
    <tr><td>UK</td><td align="left">email (null)</td><td align="left">varchar(100)</td></tr>
    <tr><td>FK</td><td align="left">city_id</td><td align="left">smallint</td></tr>
    <tr><td></td><td align="left">kyc_status</td><td align="left">varchar(10)</td></tr>
    <tr><td></td><td align="left">is_blocked</td><td align="left">boolean</td></tr>
    <tr><td></td><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];

  bank_accounts [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1a73e8" colspan="3"><font color="white"><b>bank_accounts</b></font></td></tr>
    <tr><td>PK</td><td align="left">account_id</td><td align="left">integer</td></tr>
    <tr><td>FK</td><td align="left">user_id</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">bank_name</td><td align="left">varchar(50)</td></tr>
    <tr><td></td><td align="left">ifsc</td><td align="left">varchar(11)</td></tr>
    <tr><td></td><td align="left">account_last4</td><td align="left">varchar(4)</td></tr>
    <tr><td></td><td align="left">account_type</td><td align="left">varchar(10)</td></tr>
    <tr><td></td><td align="left">is_primary (1/user)</td><td align="left">boolean</td></tr>
    <tr><td></td><td align="left">linked_at</td><td align="left">timestamptz</td></tr></table>>];

  vpas [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1a73e8" colspan="3"><font color="white"><b>vpas</b></font></td></tr>
    <tr><td>PK</td><td align="left">vpa</td><td align="left">varchar(100)</td></tr>
    <tr><td>FK</td><td align="left">user_id</td><td align="left">integer</td></tr>
    <tr><td>FK</td><td align="left">account_id</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">is_active</td><td align="left">boolean</td></tr>
    <tr><td></td><td align="left">created_at</td><td align="left">timestamptz</td></tr></table>>];

  merchants [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1a73e8" colspan="3"><font color="white"><b>merchants</b></font></td></tr>
    <tr><td>PK</td><td align="left">merchant_id</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">merchant_name</td><td align="left">varchar(100)</td></tr>
    <tr><td></td><td align="left">mcc</td><td align="left">varchar(4)</td></tr>
    <tr><td>UK</td><td align="left">merchant_vpa</td><td align="left">varchar(100)</td></tr>
    <tr><td>FK</td><td align="left">city_id</td><td align="left">smallint</td></tr>
    <tr><td></td><td align="left">is_verified</td><td align="left">boolean</td></tr>
    <tr><td></td><td align="left">onboarded_on</td><td align="left">date</td></tr></table>>];

  transactions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#188038" colspan="3"><font color="white"><b>transactions</b></font></td></tr>
    <tr><td>PK</td><td align="left">txn_id</td><td align="left">bigint</td></tr>
    <tr><td>UK</td><td align="left">upi_ref</td><td align="left">varchar(12)</td></tr>
    <tr><td></td><td align="left">txn_type</td><td align="left">P2P | P2M</td></tr>
    <tr><td>FK</td><td align="left">payer_vpa</td><td align="left">varchar(100)</td></tr>
    <tr><td>FK*</td><td align="left">payee_vpa</td><td align="left">varchar(100)</td></tr>
    <tr><td>FK*</td><td align="left">merchant_id (null P2P)</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">amount</td><td align="left">numeric(10,2)</td></tr>
    <tr><td></td><td align="left">note (null)</td><td align="left">varchar(100)</td></tr>
    <tr><td></td><td align="left">initiated_at</td><td align="left">timestamptz</td></tr>
    <tr><td></td><td align="left">completed_at (null PENDING)</td><td align="left">timestamptz</td></tr>
    <tr><td></td><td align="left">status</td><td align="left">varchar(10)</td></tr>
    <tr><td></td><td align="left">failure_code (FAILED)</td><td align="left">varchar(3)</td></tr></table>>];

  rewards [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#e37400" colspan="3"><font color="white"><b>rewards</b></font></td></tr>
    <tr><td>PK</td><td align="left">reward_id</td><td align="left">integer</td></tr>
    <tr><td>FK</td><td align="left">user_id</td><td align="left">integer</td></tr>
    <tr><td>FK,UK</td><td align="left">txn_id</td><td align="left">bigint</td></tr>
    <tr><td></td><td align="left">reward_type</td><td align="left">varchar(12)</td></tr>
    <tr><td></td><td align="left">amount</td><td align="left">numeric(8,2)</td></tr>
    <tr><td></td><td align="left">status</td><td align="left">varchar(11)</td></tr>
    <tr><td></td><td align="left">issued_at / expires_at</td><td align="left">timestamptz</td></tr>
    <tr><td></td><td align="left">credited_at (CREDITED)</td><td align="left">timestamptz</td></tr></table>>];

  bill_payments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#e37400" colspan="3"><font color="white"><b>bill_payments</b></font></td></tr>
    <tr><td>PK</td><td align="left">bill_id</td><td align="left">integer</td></tr>
    <tr><td>FK</td><td align="left">user_id</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">biller_category</td><td align="left">varchar(12)</td></tr>
    <tr><td></td><td align="left">biller_name</td><td align="left">varchar(50)</td></tr>
    <tr><td></td><td align="left">consumer_number</td><td align="left">varchar(20)</td></tr>
    <tr><td></td><td align="left">amount</td><td align="left">numeric(10,2)</td></tr>
    <tr><td></td><td align="left">due_date</td><td align="left">date</td></tr>
    <tr><td></td><td align="left">status</td><td align="left">varchar(7)</td></tr>
    <tr><td></td><td align="left">paid_at (PAID)</td><td align="left">timestamptz</td></tr></table>>];

  disputes [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#d93025" colspan="3"><font color="white"><b>disputes</b></font></td></tr>
    <tr><td>PK</td><td align="left">dispute_id</td><td align="left">integer</td></tr>
    <tr><td>FK</td><td align="left">txn_id</td><td align="left">bigint</td></tr>
    <tr><td>FK</td><td align="left">raised_by</td><td align="left">integer</td></tr>
    <tr><td></td><td align="left">reason</td><td align="left">varchar(30)</td></tr>
    <tr><td></td><td align="left">raised_at</td><td align="left">timestamptz</td></tr>
    <tr><td></td><td align="left">status</td><td align="left">varchar(8)</td></tr>
    <tr><td></td><td align="left">resolved_at (null OPEN)</td><td align="left">timestamptz</td></tr></table>>];

  // 1 : N   (tee = one, crow = many)
  cities -> users          [label="1 : N"];
  cities -> merchants      [label="1 : N"];
  users -> bank_accounts   [label="1 : 1..N  (CASCADE)"];
  users -> vpas            [label="1 : 1..N  (CASCADE)"];
  bank_accounts -> vpas    [label="1 : 1..N  FK(account_id,user_id)"];
  vpas -> transactions     [label="payer 1 : N  (RESTRICT)"];
  merchants -> transactions [label="0..1 : N  P2M only\nFK(merchant_id,payee_vpa)", arrowtail=teeodot];
  transactions -> rewards  [label="1 : 0..1", arrowhead=teeodot];
  users -> rewards         [label="1 : N"];
  users -> bill_payments   [label="1 : N"];
  transactions -> disputes [label="1 : N"];
  users -> disputes        [label="raised_by 1 : N"];
}
